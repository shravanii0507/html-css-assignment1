// Q1) Remove states starting with vowels using filter

let states = ["Maharashtra", "Uttar Pradesh", "Andhra Pradesh", "Odisha", "Karnataka", "Assam"];

let result = states.filter(function(state) {
    let firstLetter = state[0].toLowerCase();

    return firstLetter != "a" &&
           firstLetter != "e" &&
           firstLetter != "i" &&
           firstLetter != "o" &&
           firstLetter != "u";
});

console.log(result);



