// Q11) Find average marks of students

let studentsData = {
    student1: {
        subject1: 44,
        subject2: 56,
        subject3: 87,
        subject4: 97,
        subject5: 37
    },

    student2: {
        subject1: 44,
        subject2: 56,
        subject3: 87,
        subject4: 97,
        subject5: 37
    },

    student3: {
        subject1: 44,
        subject2: 56,
        subject3: 87,
        subject4: 97,
        subject5: 37
    }
};

let finalResult = {};

for(let key in studentsData) {

    let subjects = Object.values(studentsData[key]);

    let total = subjects.reduce(function(sum, marks) {
        return sum + marks;
    }, 0);

    let average = total / subjects.length;

    finalResult[key] = {
        average: average
    };
}

