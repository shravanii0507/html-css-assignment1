// Q7) Find average using map and reduce

const students = [
    { name: "Ram", scores: [80, 70, 60] },
    { name: "Mohan", scores: [80, 70, 90] },
    { name: "Sai", scores: [60, 70, 80] },
    { name: "Hemang", scores: [90, 90, 80, 80] },
];

let averages = students.map(function(student) {

    let total = student.scores.reduce(function(sum, marks) {
        return sum + marks;
    }, 0);

    let avg = total / student.scores.length;

    return {
        name: student.name,
        average: avg
    };
});

console.log(averages);



// Q8) Repeated sum of digits

function repeatedSum(num) {

    while(num > 9) {

        let sum = 0;

        let str = num.toString();

        for(let i = 0; i < str.length; i++) {

            sum = sum + Number(str[i]);
        }

        num = sum;
    }

    return num;
}

console.log(repeatedSum(456));



// Q9) Count words in paragraph

function countWords(paragraph) {

    let words = paragraph.split(" ");

    return words.length;
}

let para = "JavaScript is easy and fun to learn";

console.log(countWords(para));



