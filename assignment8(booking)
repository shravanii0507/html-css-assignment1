<!-- booking.html -->
<!DOCTYPE html>
<html>
<head>

    <title>Booking Form</title>

    <style>

        body{
            background:#dbeafe;
            font-family:Arial;
        }

        .form-box{
            width:400px;
            background:white;
            margin:auto;
            margin-top:80px;
            padding:20px;
            border-radius:10px;
            box-shadow:0px 0px 10px gray;
        }

        h1{
            text-align:center;
            color:#1e3a8a;
        }

        input{
            width:100%;
            padding:10px;
            margin-top:10px;
        }

        button{
            width:100%;
            padding:10px;
            background:#2563eb;
            color:white;
            border:none;
            margin-top:15px;
            border-radius:5px;
            cursor:pointer;
        }

    </style>

</head>

<body>

    <div class="form-box">

        <h1>Book Your Ticket</h1>

        <form action="success.html">

            <input type="text" name="name" placeholder="Enter Name" required>

            <input type="email" name="email" placeholder="Enter Email" required>

            <input type="text" name="mobile" placeholder="Enter Mobile Number" required>

            <button type="submit">Submit</button>

        </form>

    </div>

</body>
</html>
