<head>

    <title>Movie Booking System</title>

    <style>

        body{
            background-color:#dbeafe;
            font-family:Arial;
            padding:20px;
        }

        h1{
            text-align:center;
            color:#1e3a8a;
        }

        .movie-container{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:20px;
            margin-top:30px;
        }

        .movie-card{
            background:white;
            padding:10px;
            border-radius:10px;
            text-align:center;
            box-shadow:0px 0px 10px lightgray;
        }

        .movie-card img{
            width:100%;
            height:320px;
            border-radius:10px;
        }

        .movie-card h3{
            color:#1d4ed8;
        }

        .movie-card p{
            color:gray;
        }

        .movie-card button{
            background:#2563eb;
            color:white;
            border:none;
            padding:10px 15px;
            border-radius:5px;
            cursor:pointer;
        }

        .movie-card button:hover{
            background:#1d4ed8;
        }

    </style>

</head>

